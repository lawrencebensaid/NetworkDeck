CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Stream Deck gen2 decks use 1024-byte interrupt OUT reports
CONFIG_USB_HOST_HW_BUFFER_BIAS_PERIODIC_OUT=y
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_LWIP_MAX_SOCKETS=16

# Firmware updates: roll back to the previous image if a new one doesn't mark itself valid.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Wi-Fi co-processor: the P4-NANO used here carries an ESP32-C5 (esp-hosted 2.12.9), not a C6.
CONFIG_SLAVE_IDF_TARGET_ESP32C5=y

# Image streaming: the socket receive mailbox was 6 packets, which capped TCP at ~500 KB/s whatever the
# window. Room for a full 64 KB window of 1440-byte segments, and Ethernet DMA buffers of one frame each.
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_ETH_DMA_RX_BUFFER_NUM=40
CONFIG_ETH_DMA_TX_BUFFER_NUM=20
CONFIG_ETH_DMA_BUFFER_SIZE=1536
